# ---------------------------------------------------------------- database
# Supabase → Connect → connection string. Use the POOLER host, not
# db.<project-ref>.supabase.co — that one is IPv6-only and Vercel cannot reach it.
#
# DATABASE_URL: transaction pooler, port 6543. What the app uses at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# DIRECT_URL: session pooler, port 5432. Used by `npm run db:migrate` and the seed.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# URL-encode special characters in the password (@ → %40, # → %23, / → %2F …).
# Do not add ?sslmode=… — TLS is set up in src/lib/db-ssl.ts.

# optional: how many real connections each serverless instance may open
DB_POOL_MAX=5

# optional: Supabase → Database Settings → SSL certificate (PEM). With it the
# server certificate is verified; without it the link is encrypted but unpinned.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# local throwaway Postgres instead (npm run db:dev):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"

# ------------------------------------------------------------------- auth
# Generate with:  npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET=""

# Company login ids are name.sur@<this domain>
NEXT_PUBLIC_LOGIN_DOMAIN="1moby.com"

# Origin written into activation and reset links. Optional — the request's own
# host is used when unset, which is right on Vercel.
# APP_URL="https://assessment.1moby.com"

# Optional federation to the company identity provider (OpenID Connect).
# Accounts must still be created in Administration → Accounts first.
# Callback URL to register with the provider: https://<your-domain>/api/auth/callback/sso
# AUTH_SSO_ISSUER="https://login.example.com/realms/1moby"
# AUTH_SSO_CLIENT_ID=""
# AUTH_SSO_CLIENT_SECRET=""
# AUTH_SSO_NAME="1Moby SSO"

# --------------------------------------------------------------- demo mode
# Test mode: when true, clicking the Login ID field suggests three seeded
# accounts and fills in their ID and SEED_DEMO_PASSWORD. The password reaches the
# browser, so leave this false in a real deployment.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="false"

# ------------------------------------------------------------------- seed
# `npm run db:seed` gives every seeded account this password (10+ characters,
# a letter and a number). Demo data only — real people activate their own.
SEED_DEMO_PASSWORD=""
# SEED_ADMIN_EMAIL="neo.hro@1moby.com"

# ------------------------------------------------------------ keep-alive
# Vercel Cron signs its daily call to /api/keepalive with this secret.
# CRON_SECRET=""
# Optional: also ping Supabase's API so the project counts as active.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_PUBLISHABLE_KEY=""

# ------------------------------------------------------------ learning media
# Vercel Blob store that holds uploaded shorts, PDFs and chapter files.
# Vercel → Storage → Blob → connect to the project; `vercel env pull .env.local`
# brings the token down for local development.
BLOB_READ_WRITE_TOKEN=""
