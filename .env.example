# ---------------------------------------------------------------- database
# Supabase → Project Settings → Database → Connection string
#
# DATABASE_URL is the *pooled* connection (Transaction mode, port 6543). The app
# uses it at runtime. Keep ?pgbouncer=true so Prisma disables prepared statements.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL is the *direct* connection (Session mode, port 5432). Only used by
# `prisma migrate` and `prisma db push`; pgBouncer cannot run DDL.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# optional: how many real connections each serverless instance may open
DB_POOL_MAX=5

# ------------------------------------------------------------------- auth
# Generate with:  npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
#   Application type: Web application
#   Authorised redirect URI (local): http://localhost:3000/api/auth/callback/google
#   Authorised redirect URI (prod):  https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Set to your deployed origin in production, e.g. https://1moby-demo.vercel.app
# Vercel sets this for you; only needed locally if you change the port.
# NEXTAUTH_URL="http://localhost:3000"

# --------------------------------------------------------------- demo mode
# When true, the login screen also offers the seeded demo accounts so the system
# can be walked through in a meeting without anyone having a Google account.
# Leave this false in a real deployment.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="true"

# Comma-separated emails that are granted the admin role the first time they
# sign in with Google. Everyone else lands in PENDING until an admin approves.
BOOTSTRAP_ADMIN_EMAILS=""
